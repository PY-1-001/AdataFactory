{
	"name": "pipeline1",
	"properties": {
		"activities": [
			{
				"name": "Lookup_OldWatermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "Select TableName,isnull(WatermarkValue,'2010-01-01 00:00:00.000') as lastruntime from watermarktable where TableName='orders'",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable2",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Lookup_NewWatermark",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": "SELECT MAX(CreatedDate) as newWaterMarkValue\nFROM Orders",
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				}
			},
			{
				"name": "Copy_Incremental_Orders",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Lookup_NewWatermark",
						"dependencyConditions": [
							"Completed"
						]
					},
					{
						"activity": "Lookup_OldWatermark",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * \nFROM Orders \nWHERE CreatedDate BETWEEN \nCAST('@{activity('Lookup_OldWatermark').output.firstRow.lastruntime}' as DATETIME)\nAND \nCAST('@{activity('Lookup_NewWatermark').output.firstRow.newWaterMarkValue}' as DATETIME)",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings",
							"copyBehavior": {
								"value": "@concat(\n'IncrementalLoad-',\nformatDateTime(utcNow(),'yyyy-MM-dd_HHmmss'),\n'.csv'\n)",
								"type": "Expression"
							}
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_Blob_Orders",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "SP_UpdateWatermark",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Copy_Incremental_Orders",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[update_watermarkvalue]",
					"storedProcedureParameters": {
						"TableName": {
							"value": "orders",
							"type": "String"
						},
						"LastModifiedtime": {
							"value": {
								"value": "@activity('Lookup_NewWatermark').output.firstRow.newWaterMarkValue",
								"type": "Expression"
							},
							"type": "Datetime"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "successStoredprocedure",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SP_UpdateWatermark",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[SP_LogSuccess]",
					"storedProcedureParameters": {
						"PipelineName": {
							"value": {
								"value": "@pipeline().Pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActivityName": {
							"value": "Copy_Incremental_Orders",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "Failure_CopyActivity_SP",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "SP_UpdateWatermark",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[SP_LogFailure]",
					"storedProcedureParameters": {
						"PipelineName": {
							"value": {
								"value": "@pipeline().pipeline",
								"type": "Expression"
							},
							"type": "String"
						},
						"ActivityName": {
							"value": "Copy_Incremental_Orders",
							"type": "String"
						},
						"ErrorMessage": {
							"value": {
								"value": "@activity('Copy_Incremental_Orders').Error.Message",
								"type": "Expression"
							},
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-06-03T07:08:42Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}